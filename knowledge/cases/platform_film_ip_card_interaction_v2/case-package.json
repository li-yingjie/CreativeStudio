    "summary": "一套影视IP抽卡活动的平台交互与状态规范，分四轮描述公告与新手引导、换卡与批量赠卡、翻卡奖励以及完整交互。画板内《永夜星河》、卡级、任务和文案主要用于演示能力，不构成某个已上线业务案例的最终配置。"
  },
  "sources": [
    {
      "source_id": "src_film_ip_card_figma",
      "title": "影视IP抽卡活动｜2.0优化交互详述（待开发）",
      "source_type": "figma_platform_interaction_spec",
      "url": "https://www.figma.com/design/DuLYQtdj91zgshbF24RId1/影视IP抽卡活动?node-id=13-12157",
      "permission_scope": "internal_restricted"
    }
  ],
  "mechanics": [
    {"id":"mechanic_onboarding","name":"新用户分步引导","description":"通过页面滑动、任务按钮高亮、气泡提示和手势引导，依次教用户做任务、获取次数和发起抽卡。","confirmation":"confirmed","evidence_ids":["ev_iteration_1"]},
    {"id":"mechanic_announcement","name":"活动公告","description":"支持短公告直接展示、长公告点击展开；无公告时隐藏公告位并恢复副标题区域。","confirmation":"confirmed","evidence_ids":["ev_iteration_1"]},
    {"id":"mechanic_task_earn","name":"任务赚取抽卡机会","description":"任务区与抽卡次数联动；画板罗列的签到、想看、关注、浏览、搜索、投稿等均为可配置示例，并非某个活动已确认任务单。","confirmation":"confirmed","evidence_ids":["ev_iteration_1","ev_demo_boundary"]},
    {"id":"mechanic_draw","name":"单抽与十连抽","description":"主页面支持单次抽卡和十次连抽，并呈现抽卡次数与结果反馈。","confirmation":"confirmed","evidence_ids":["ev_iteration_1","ev_iteration_4"]},
    {"id":"mechanic_album","name":"卡册与集齐状态","description":"卡册呈现已获得、未获得、重复数量及集齐/未集齐状态，并承接单卡详情。","confirmation":"confirmed","evidence_ids":["ev_iteration_2","ev_iteration_4"]},
    {"id":"mechanic_gifting","name":"单张与批量赠卡","description":"用户从可赠卡中选择一张或多张分享；领取端校验活动、链接状态和库存，并返回成功或失败结果。","confirmation":"confirmed","evidence_ids":["ev_iteration_2"]},
    {"id":"mechanic_exchange","name":"双向换卡","description":"发起方分别配置送出与想要的卡片，平台在接收方打开后校验活动、交换状态和双方库存，再执行交换。","confirmation":"confirmed","evidence_ids":["ev_iteration_2"]},
    {"id":"mechanic_exchange_guardrails","name":"换卡库存与幂等保护","description":"覆盖至少选择一张、无可换卡、双方库存不足、活动结束、已被交换等异常分支，避免重复或无效交换。","confirmation":"confirmed","evidence_ids":["ev_iteration_2"]},
    {"id":"mechanic_social_return","name":"分享、私信与群聊回流","description":"赠卡与换卡通过分享面板外发，并提供私信或活动群聊等继续协作入口。","confirmation":"confirmed","evidence_ids":["ev_iteration_2","ev_iteration_4"]},
    {"id":"mechanic_records","name":"赠卡与换卡记录","description":"记录区区分送出/收到、赠送/交换、时间与领取人，并配置空状态。","confirmation":"confirmed","evidence_ids":["ev_iteration_2","ev_iteration_4"]},
    {"id":"mechanic_flip_card","name":"翻卡机会与延后使用","description":"翻卡次数可累计；抽卡时未使用的机会会在小卡、卡册和大图预览中继续提示，单抽与多抽均可进入翻卡。","confirmation":"confirmed","evidence_ids":["ev_iteration_3"]},
    {"id":"mechanic_reward_routing","name":"翻卡奖励承接","description":"翻卡结果可承接电商券、兑换码、音频、图片、视频或实物等奖励，并路由到奖品中心、卡券、地址填写、复制兑换码或媒体预览。","confirmation":"confirmed","evidence_ids":["ev_iteration_3","ev_iteration_4"]},
    {"id":"mechanic_request_card","name":"求卡与协作入口","description":"用户可选择缺少的卡发起求卡并分享链接；已有卡不能求、集齐后不可求，每张卡一次只求一张。接收方打开链接后校验领取状态和库存，并可继续进入群聊或私信沟通。设计已明确，是否开发上线仍待确认。","confirmation":"confirmed","evidence_ids":["ev_iteration_4"]}
  ],
  "tasks": [],
  "card_tiers": [],
  "touchpoints": [
    {"id":"surface_home","name":"活动主页面","description":"包含IP主题头图、公告、卡片陈列、单抽/十连和任务区。","confirmation":"confirmed","evidence_ids":["ev_iteration_1","ev_iteration_4"]},
    {"id":"surface_task_panel","name":"任务列表","description":"呈现任务进度、奖励次数和行动按钮。","confirmation":"confirmed","evidence_ids":["ev_iteration_1"]},
    {"id":"surface_album","name":"卡册与单卡详情","description":"查看卡片持有、缺失、重复与集齐状态，并进入赠卡、换卡或翻卡。","confirmation":"confirmed","evidence_ids":["ev_iteration_2","ev_iteration_3"]},
    {"id":"surface_share_return","name":"赠卡/换卡分享与回流页","description":"生成一张或多张卡片的分享内容，接收方打开后进入领取或交换校验。","confirmation":"confirmed","evidence_ids":["ev_iteration_2"]},
    {"id":"surface_records","name":"赠换记录","description":"展示送出、收到、交换、领取人、时间和空状态。","confirmation":"confirmed","evidence_ids":["ev_iteration_2"]},
    {"id":"surface_prize_center","name":"我的奖品与奖励详情","description":"奖品按获得时间倒序；实物奖覆盖填写地址、修改地址、已过期，电子奖覆盖查看与已过期，并记录上次地址以减少重复输入。","confirmation":"confirmed","evidence_ids":["ev_iteration_3","ev_iteration_4"]},
    {"id":"surface_announcement_dialog","name":"公告详情弹层","description":"长公告从主页公告位进入弹层查看。","confirmation":"confirmed","evidence_ids":["ev_iteration_1"]}
  ],
