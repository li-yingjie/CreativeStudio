# Copy to .env and fill in your own key. .env is gitignored.
# Get a key at https://platform.kimi.com/console/account
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
# Optional comma-separated client-selectable models; defaults to KIMI_MODEL only.
KIMI_ALLOWED_MODELS=moonshot-v1-8k
KIMI_MAX_CONCURRENT=4
KIMI_RATE_LIMIT_MAX=15
KIMI_RATE_LIMIT_WINDOW_MS=60000
KIMI_TIMEOUT_MS=45000
# 仅在可信反向代理会覆盖 X-Forwarded-* 时开启；Vercel/Cloudflare 自动识别。
TRUST_PROXY_HEADERS=false
KIMI_MAX_OUTPUT_TOKENS=2048
KIMI_MAX_OUTPUT_BYTES=2000000

# Backend port (frontend talks to it via the Vite /api proxy in dev).
PORT=8787

# TinyPNG — only for scripts/compress-images.mjs. Get a free key at
# https://tinypng.com/developers
TINYPNG_API_KEY=your-tinypng-key-here
